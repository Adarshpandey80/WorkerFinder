<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register as a Plumber | Worker-Finder</title>
    <link rel="stylesheet" href="/css/form.css">
</head>
<body class="worker-form-page">
    <form action="/formplumber" method="POST" enctype="multipart/form-data" class="worker-form">
        <a class="form-brand" href="/home">Worker<span>-Finder</span></a>
        <header class="form-header">
            <div class="service-badge">Plumber registration</div>
            <h1>Welcome, plumber.</h1>
            <p>Introduce your services to local customers and grow your work with a profile they can trust.</p>
        </header>
        <div class="form-grid">
            <div class="form-field">
                <label for="name">Your name</label>
                <input type="text" name="name" id="name" placeholder="e.g. Rahul Sharma" required>
            </div>
            <div class="form-field">
                <label for="contact">Contact number</label>
                <input type="number" name="contact" id="contact" placeholder="Your phone number" required>
            </div>
            <div class="form-field">
                <label for="rate">Service rate</label>
                <input type="number" name="rate" id="rate" placeholder="Rate per service" required>
            </div>
            <div class="form-field">
                <label for="location">Location</label>
                <input type="text" name="location" id="location" placeholder="City or area" required>
            </div>
            <div class="form-field full-width">
                <label for="country">Country</label>
                <input type="text" name="country" id="country" placeholder="Country" required>
            </div>
            <div class="form-field full-width">
                <label for="experience">About your experience</label>
                <textarea name="experience" id="experience" placeholder="Share a little about your experience and specialties"></textarea>
            </div>
            <div class="form-field full-width">
                <label for="image">Profile image</label>
                <input type="file" name="image" id="image">
            </div>
        </div>
        <input class="form-submit" type="submit" value="Complete registration">

    </form>
</body>
</html>